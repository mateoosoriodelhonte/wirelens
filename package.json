{
  "name": "wirelens",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first visual network protocol inspector",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm --recursive --if-present check",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "test:parity": "node --test scripts/check-contract-parity.test.mjs && node scripts/check-contract-parity.mjs build/native-debug/cli/wirelens web/static/wasm/wirelens.js",
    "test:e2e": "pnpm --dir web test:e2e",
    "verify:phase1": "bash scripts/verify-phase1.sh",
    "verify:phase2": "bash scripts/verify-phase2.sh"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
