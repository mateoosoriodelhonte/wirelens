{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirelens.local/schema/capture.schema.json",
  "title": "WireLens capture document",
  "type": "object",
  "required": [
    "schema",
    "contractVersion",
    "capture",
    "endpoints",
    "packets",
    "flows",
    "dnsExchanges",
    "httpExchanges",
    "tlsHandshakes",
    "observations",
    "diagnostics"
  ],
  "properties": {
    "schema": { "const": "wirelens.capture" },
    "contractVersion": { "const": "2.0.0" },
    "capture": { "$ref": "#/$defs/capture" },
    "endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpoint" } },
    "packets": { "type": "array", "items": { "$ref": "#/$defs/packet" } },
    "flows": {
      "type": "array",
      "items": { "oneOf": [{ "$ref": "#/$defs/tcpFlow" }, { "$ref": "#/$defs/udpFlow" }] }
    },
    "dnsExchanges": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/dnsExchange" }
    },
    "httpExchanges": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/httpExchange" }
    },
    "tlsHandshakes": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/tlsHandshake" }
    },
    "observations": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/observation" }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "decimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "byteRange": {
      "type": "object",
      "required": ["captureOffset", "packetOffset", "length"],
      "properties": {
        "captureOffset": { "$ref": "#/$defs/nonNegativeInteger" },
        "packetOffset": { "$ref": "#/$defs/nonNegativeInteger" },
        "length": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "capture": {
      "type": "object",
      "required": [
        "format",
        "timestampResolution",
        "packetCount",
        "capturedBytes",
        "originalBytes",
        "startTimestampNs",
        "endTimestampNs",
        "durationNs",
        "interfaces"
      ],
      "properties": {
        "format": { "enum": ["pcap", "pcapng"] },
        "timestampResolution": {
          "enum": ["microseconds", "nanoseconds", "binary", "custom", "mixed"]
        },
        "packetCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "capturedBytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "originalBytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "startTimestampNs": { "anyOf": [{ "$ref": "#/$defs/decimalString" }, { "type": "null" }] },
        "endTimestampNs": { "anyOf": [{ "$ref": "#/$defs/decimalString" }, { "type": "null" }] },
        "durationNs": { "$ref": "#/$defs/decimalString" },
        "interfaces": { "type": "array", "items": { "$ref": "#/$defs/captureInterface" } }
      }
    },
    "captureInterface": {
      "type": "object",
      "required": ["id", "linkType", "snapLength", "timestampResolution"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "linkType": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "snapLength": { "type": "integer", "minimum": 0 },
        "timestampResolution": { "enum": ["microseconds", "nanoseconds", "binary", "custom"] }
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["id", "address", "port", "addressFamily"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "addressFamily": { "enum": ["ipv4", "ipv6", "unknown"] }
      }
    },
    "packet": {
      "type": "object",
      "required": [
        "id",
        "number",
        "timestampNs",
        "capturedLength",
        "originalLength",
        "interfaceId",
        "sourceEndpointId",
        "destinationEndpointId",
        "summary",
        "layers",
        "flowId",
        "analysisFlags"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^packet-[1-9][0-9]*$" },
        "number": { "type": "integer", "minimum": 1 },
        "timestampNs": { "$ref": "#/$defs/decimalString" },
        "capturedLength": { "$ref": "#/$defs/nonNegativeInteger" },
        "originalLength": { "$ref": "#/$defs/nonNegativeInteger" },
        "interfaceId": { "anyOf": [{ "$ref": "#/$defs/nonNegativeInteger" }, { "type": "null" }] },
        "sourceEndpointId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "destinationEndpointId": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "summary": { "type": "string" },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/protocolLayer" } },
        "flowId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "analysisFlags": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "protocolLayer": {
      "type": "object",
      "required": ["protocol", "label", "fields", "byteRange", "explanationKey"],
      "properties": {
        "protocol": {
          "enum": ["ETHERNET", "IPV4", "IPV6", "TCP", "UDP", "DNS", "HTTP", "TLS", "UNKNOWN"]
        },
        "label": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/protocolField" } },
        "byteRange": { "anyOf": [{ "$ref": "#/$defs/byteRange" }, { "type": "null" }] },
        "explanationKey": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    },
    "protocolField": {
      "type": "object",
      "required": ["name", "value", "byteRange", "explanationKey"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "byteRange": { "anyOf": [{ "$ref": "#/$defs/byteRange" }, { "type": "null" }] },
        "explanationKey": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    },
    "tcpFlow": {
      "type": "object",
      "required": [
        "id",
        "protocol",
        "clientEndpointId",
        "serverEndpointId",
        "startTimestampNs",
        "endTimestampNs",
        "packetNumbers",
        "capturedBytes",
        "originalBytes",
        "handshake",
        "midStream",
        "termination",
        "events"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^tcp-flow-[1-9][0-9]*$" },
        "protocol": { "const": "TCP" },
        "clientEndpointId": { "type": "string", "minLength": 1 },
        "serverEndpointId": { "type": "string", "minLength": 1 },
        "startTimestampNs": { "anyOf": [{ "$ref": "#/$defs/decimalString" }, { "type": "null" }] },
        "endTimestampNs": { "anyOf": [{ "$ref": "#/$defs/decimalString" }, { "type": "null" }] },
        "packetNumbers": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "capturedBytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "originalBytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "handshake": { "enum": ["complete", "partial", "unobserved"] },
        "midStream": { "type": "boolean" },
        "termination": { "enum": ["graceful", "reset", "open-at-capture-end", "unknown"] },
        "events": { "type": "array", "items": { "$ref": "#/$defs/tcpEvent" } }
      }
    },
    "udpFlow": {
      "type": "object",
      "required": [
        "id",
        "protocol",
        "clientEndpointId",
        "serverEndpointId",
        "startTimestampNs",
        "endTimestampNs",
        "packetNumbers",
        "capturedBytes",
        "originalBytes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^udp-flow-[1-9][0-9]*$" },
        "protocol": { "const": "UDP" },
        "clientEndpointId": { "type": "string", "minLength": 1 },
        "serverEndpointId": { "type": "string", "minLength": 1 },
        "startTimestampNs": { "anyOf": [{ "$ref": "#/$defs/decimalString" }, { "type": "null" }] },
        "endTimestampNs": { "anyOf": [{ "$ref": "#/$defs/decimalString" }, { "type": "null" }] },
        "packetNumbers": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "capturedBytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "originalBytes": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "tcpEvent": {
      "type": "object",
      "required": ["packetNumber", "label"],
      "properties": {
        "packetNumber": { "type": "integer", "minimum": 1 },
        "label": { "enum": ["SYN", "SYN + ACK", "ACK", "FIN", "FIN + ACK", "RST", "DATA"] }
      }
    },
    "dnsQuestion": {
      "type": "object",
      "required": ["name", "type", "class"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "class": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "dnsRecord": {
      "type": "object",
      "required": ["name", "type", "class", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "class": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "value": { "type": "string" }
      }
    },
    "dnsExchange": {
      "type": "object",
      "required": [
        "id",
        "question",
        "queryPacketNumber",
        "responsePacketNumber",
        "responseCode",
        "answers",
        "latencyNs",
        "matched"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^dns-exchange-[1-9][0-9]*$" },
        "question": { "$ref": "#/$defs/dnsQuestion" },
        "queryPacketNumber": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "responsePacketNumber": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "responseCode": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "answers": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/dnsRecord" }
        },
        "latencyNs": { "anyOf": [{ "$ref": "#/$defs/decimalString" }, { "type": "null" }] },
        "matched": { "type": "boolean" }
      }
    },
    "httpHeader": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value", "redacted"],
          "properties": {
            "name": {
              "enum": [
                "host",
                "content-type",
                "content-length",
                "accept",
                "user-agent",
                "server",
                "date"
              ]
            },
            "value": { "type": "string", "maxLength": 8192 },
            "redacted": { "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value", "redacted"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
            },
            "value": { "type": "null" },
            "redacted": { "const": true }
          }
        }
      ]
    },
    "httpRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "method", "target", "version", "headers", "packetNumbers"],
      "properties": {
        "line": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
        },
        "target": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "version": { "enum": ["HTTP/1.0", "HTTP/1.1"] },
        "headers": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/httpHeader" }
        },
        "packetNumbers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "httpResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "version", "statusCode", "reason", "headers", "packetNumbers"],
      "properties": {
        "line": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "version": { "enum": ["HTTP/1.0", "HTTP/1.1"] },
        "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 },
        "reason": { "type": "string", "maxLength": 256 },
        "headers": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/httpHeader" }
        },
        "packetNumbers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "httpExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "flowId", "request", "response", "latencyNs", "matched"],
      "properties": {
        "id": { "type": "string", "pattern": "^http-exchange-[1-9][0-9]*$" },
        "flowId": { "type": "string", "pattern": "^tcp-flow-[1-9][0-9]*$" },
        "request": { "anyOf": [{ "$ref": "#/$defs/httpRequest" }, { "type": "null" }] },
        "response": { "anyOf": [{ "$ref": "#/$defs/httpResponse" }, { "type": "null" }] },
        "latencyNs": { "anyOf": [{ "$ref": "#/$defs/decimalString" }, { "type": "null" }] },
        "matched": { "type": "boolean" }
      }
    },
    "tlsVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "tlsClientHello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordVersion",
        "legacyVersion",
        "offeredVersions",
        "serverName",
        "packetNumbers"
      ],
      "properties": {
        "recordVersion": { "$ref": "#/$defs/tlsVersion" },
        "legacyVersion": { "$ref": "#/$defs/tlsVersion" },
        "offeredVersions": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/tlsVersion" }
        },
        "serverName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9.-]+$"
            },
            { "type": "null" }
          ]
        },
        "packetNumbers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "tlsServerHello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordVersion", "legacyVersion", "negotiatedVersion", "packetNumbers"],
      "properties": {
        "recordVersion": { "$ref": "#/$defs/tlsVersion" },
        "legacyVersion": { "$ref": "#/$defs/tlsVersion" },
        "negotiatedVersion": {
          "anyOf": [{ "$ref": "#/$defs/tlsVersion" }, { "type": "null" }]
        },
        "packetNumbers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "tlsHandshake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "flowId", "clientHello", "serverHello", "matched", "limitation"],
      "properties": {
        "id": { "type": "string", "pattern": "^tls-handshake-[1-9][0-9]*$" },
        "flowId": { "type": "string", "pattern": "^tcp-flow-[1-9][0-9]*$" },
        "clientHello": {
          "anyOf": [{ "$ref": "#/$defs/tlsClientHello" }, { "type": "null" }]
        },
        "serverHello": {
          "anyOf": [{ "$ref": "#/$defs/tlsServerHello" }, { "type": "null" }]
        },
        "matched": { "type": "boolean" },
        "limitation": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "observation": {
      "type": "object",
      "required": ["id", "type", "message", "packetNumbers", "limitation"],
      "properties": {
        "id": { "type": "string", "pattern": "^observation-[1-9][0-9]*$" },
        "type": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "packetNumbers": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "limitation": { "type": "string", "minLength": 1 }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "severity",
        "code",
        "message",
        "context",
        "captureOffset",
        "packetNumber",
        "count"
      ],
      "properties": {
        "severity": { "enum": ["info", "warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "context": { "type": "string" },
        "captureOffset": {
          "anyOf": [{ "$ref": "#/$defs/nonNegativeInteger" }, { "type": "null" }]
        },
        "packetNumber": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "count": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
      }
    }
  }
}
